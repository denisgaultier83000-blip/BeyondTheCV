server {
    # Cette directive sera remplacée par la variable d'environnement PORT au démarrage.
    # Nginx écoutera sur 0.0.0.0:${PORT}
    listen PORT_PLACEHOLDER;

    # Racine standard et fichier d'index pour les applications web.
    root /usr/share/nginx/html;
    index index.html;

    # Indispensable pour les Single Page Applications (SPA) comme React, Vue, Angular.
    # Si une URL comme /mon-profil n'est pas un fichier ou un dossier, Nginx renvoie index.html.
    # Le routeur côté client (React Router) prend alors le relais.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # L'HTML d'entrée ne doit pas être mis en cache, afin que chaque déploiement soit pris en compte.
    location = /index.html {
        add_header Cache-Control "no-cache";
        expires off;
    }

    # Les assets hashés par Vite peuvent être mis en cache indéfiniment (leur nom change avec leur contenu).
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Fichiers statiques (utiliser des noms versionnés si vous souhaitez un cache très long).
    location ~* \.(?:css|js|jpg|jpeg|gif|png|svg|ico|webp|avif|woff|woff2)$ {
        expires 6M;
        add_header Cache-Control "public";
    }
}