# c:\BeyondTheCV\front\Dockerfile
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# [FIX] Exposition du port 5173, le standard de Vite utilisé dans docker-compose.
EXPOSE 5173

# [FIX] La commande `npm create vite` génère `npm run dev`.
# On s'assure que le serveur Vite est accessible depuis l'extérieur du conteneur.
CMD ["npm", "run", "dev"]